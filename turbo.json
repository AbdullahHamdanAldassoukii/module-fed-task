{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["UI_KIT", "APP_ENV", "CI"],
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**"], "env": ["UI_KIT"] },
    "dev": { "cache": false, "persistent": true },
    "lint": { "dependsOn": ["^lint"] },
    "typecheck": { "dependsOn": ["^typecheck"] },
    "test": { "dependsOn": ["^test"], "env": ["UI_KIT"], "outputs": [] }
  }
}
